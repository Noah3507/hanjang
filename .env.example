# Server-only settings. Copy to root .env; never commit real secrets.
# JSON array of explicit origins; no wildcard.
HANJANG_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional server-only photo settings; absent model uses original fallback.
HANJANG_PHOTO_TIMEOUT_SECONDS=90
HANJANG_PHOTO_MAX_SIDE=1600
# HANJANG_PHOTO_MODEL_PATH=C:/path/to/hanjang/artifacts/models/rembg/u2netp.onnx
# Future LLM and real ranking adapters are not implemented yet.


# Optional server-only ranking model FILE, relative to repository root.
# Empty/unset is valid. No automatic model loading or downloading.
RANKING_MODEL_PATH=
# Example after B supplies an approved artifact bundle:
# RANKING_MODEL_PATH=artifacts/models/ranking/v1/model.onnx
# Product analysis: optional A-only worker. Never auto-downloads weights.
# HANJANG_ANALYSIS_PYTHON=C:/path/to/hanjang/.venv-analysis/Scripts/python.exe
# HANJANG_ANALYSIS_MODEL_PATH=C:/path/to/hanjang/artifacts/models/analysis/ViT-B-32.pt
# HANJANG_ANALYSIS_TIMEOUT_SECONDS=120
# HANJANG_ANALYSIS_IDLE_SECONDS=300
