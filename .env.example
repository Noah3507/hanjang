# Server-only settings. Copy to root .env; never commit real secrets.
# JSON array of explicit origins; no wildcard.
HANJANG_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional server-only photo settings; absent model uses original fallback.
HANJANG_PHOTO_TIMEOUT_SECONDS=90
HANJANG_PHOTO_MAX_SIDE=1600
# HANJANG_PHOTO_MODEL_PATH=C:/path/to/hanjang/artifacts/models/rembg/u2netp.onnx
# Future LLM/ranking settings are intentionally not implemented yet.
